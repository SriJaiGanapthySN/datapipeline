# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environment
.venv/
venv/
env/
ENV/

# ===========================
# Environment Files (Secrets)
# ===========================
.env
.env.*
config/dev.env
config/stage.env
config/prod.env

# Keep sample environment files if created later
!config/*.env.example

# ===========================
# VS Code
# ===========================
.vscode/
.history/

# ===========================
# JetBrains IDE
# ===========================
.idea/

# ===========================
# Windows
# ===========================
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# ===========================
# Logs
# ===========================
*.log
logs/
*.out

# ===========================
# PostgreSQL Dumps
# ===========================
*.sql.backup
*.dump
*.bak

# ===========================
# Flyway
# ===========================
# Ignore local secrets generated by Flyway Desktop
flyway-desktop*
*.flyway-user
*.flyway-cache

# Keep migration scripts and project config
!flyway/
!flyway/sql/**
!flyway.toml

# Ignore local callback outputs (if generated)
flyway/callbacks/*.log

# ===========================
# Temporary Files
# ===========================
tmp/
temp/
*.tmp
*.swp
*.swo

